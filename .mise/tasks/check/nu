#!/usr/bin/env nu
#MISE description="Check Nushell source files for syntax errors"

let root = $env.MISE_PROJECT_ROOT
let files = (
  ^jj --quiet file list
  | lines
  | where {|file|
      let is_nu_source = $file | str ends-with ".nu"
      let is_project_task = $file | str starts-with ".mise/tasks/"
      let is_global_task = $file | str starts-with ".config/mise/tasks/"
      $is_nu_source or $is_project_task or $is_global_task
    }
  | each {|file| $root | path join $file }
)
let invalid = $files | where {|file| not (nu-check $file) }

if ($invalid | is-not-empty) {
  error make {
    msg: "Nushell syntax checks failed"
    help: ($invalid | str join (char newline))
  }
}
