#!/usr/bin/env nu
#MISE description="Verify the mise and ya-pkg-owned Yazi distribution"

let root = $env.MISE_PROJECT_ROOT
let manifest_path = $root | path join ".config" "yazi" "package.toml"
let expected_plugins = ([
  yazi-rs/plugins:chmod
  yazi-rs/plugins:smart-enter
  yazi-rs/plugins:smart-filter
] | sort)
let expected_flavors = ([
  yazi-rs/flavors:catppuccin-latte
  yazi-rs/flavors:catppuccin-macchiato
] | sort)

for executable in [yazi ya] {
  let result = ^mise which $executable | complete
  if $result.exit_code != 0 {
    error make { msg: $"Mise does not provide ($executable)" }
  }
}

let manifest = open $manifest_path
let plugins = $manifest.plugin.deps.use | sort
let flavors = $manifest.flavor.deps.use | sort

if $plugins != $expected_plugins {
  error make { msg: "Yazi plugin manifest does not match the supported plugin set" }
}
if $flavors != $expected_flavors {
  error make { msg: "Yazi flavor manifest does not match the supported flavor set" }
}

let plugins_dir = $env.HOME | path join ".config" "yazi" "plugins"
let expected_plugin_dirs = ($plugins | each {|package|
  let name = $package | split row ":" | last | path basename
  $"($name).yazi"
} | sort)
let installed_plugin_dirs = (glob ($plugins_dir | path join "*.yazi")
  | each {|path| $path | path basename }
  | sort)
if $installed_plugin_dirs != $expected_plugin_dirs {
  error make { msg: "Installed Yazi plugins do not exactly match package.toml" }
}

for package in $plugins {
  let name = $package | split row ":" | last | path basename
  let path = $plugins_dir | path join $"($name).yazi"
  if not ($path | path exists) {
    error make { msg: $"Yazi plugin is not installed: ($name)" }
  }
  if ($path | path type) != "dir" {
    error make { msg: $"Yazi plugin is not ya-pkg-owned: ($name)" }
  }
}

let flavors_dir = $env.HOME | path join ".config" "yazi" "flavors"
let expected_flavor_dirs = ($flavors | each {|package|
  let name = $package | split row ":" | last | path basename
  $"($name).yazi"
} | sort)
let installed_flavor_dirs = (glob ($flavors_dir | path join "*.yazi")
  | where {|path| ($path | path basename) not-in [current-dark.yazi current-light.yazi] }
  | each {|path| $path | path basename }
  | sort)
if $installed_flavor_dirs != $expected_flavor_dirs {
  error make { msg: "Installed Yazi flavors do not exactly match package.toml" }
}

for package in $flavors {
  let name = $package | split row ":" | last | path basename
  let path = $flavors_dir | path join $"($name).yazi"
  if not ($path | path exists) {
    error make { msg: $"Yazi flavor is not installed: ($name)" }
  }
  if ($path | path type) != "dir" {
    error make { msg: $"Yazi flavor is not ya-pkg-owned: ($name)" }
  }
}

let theme_flavors = [
  ($flavors_dir | path join "catppuccin-latte.yazi" | path expand)
  ($flavors_dir | path join "catppuccin-macchiato.yazi" | path expand)
]
for name in [current-dark.yazi current-light.yazi] {
  let link = $flavors_dir | path join $name
  if ($link | path type) != "symlink" {
    error make { msg: $"Yazi runtime flavor is not a symlink: ($name)" }
  }
  if ($link | path expand) not-in $theme_flavors {
    error make { msg: $"Yazi runtime flavor has an unexpected target: ($name)" }
  }
}
