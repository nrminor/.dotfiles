#!/usr/bin/env nu
#MISE description="Check pinned Rex SDK installer safety and consumer imports without connecting to Rex"

def main [--offline] {
  let args = if $offline { [--offline] } else { [] }
  ^$nu.current-exe --no-config-file ($env.MISE_PROJECT_ROOT | path join scripts/check-rex-sdk.nu) ...$args
  exit $env.LAST_EXIT_CODE
}
