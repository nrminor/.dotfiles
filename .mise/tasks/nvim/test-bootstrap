#!/usr/bin/env nu
#MISE description="Restore native Neovim from locks in isolated mutable state"
#MISE tools.neovim="0.12.4"

let root = $env.MISE_PROJECT_ROOT
let runner = $root | path join "scripts" "test-nvim-startup.lua"
let lockfile = $root | path join ".config" "nvim" "nvim-pack-lock.json"
let sandbox = $env.TMPDIR | path join $"nvim-bootstrap-(random uuid)"
let lock_before = open --raw $lockfile | hash sha256

mkdir $sandbox

def run-startup [check_parsers: bool] {
  with-env { NRM_SKIP_PARSER_CHECKS: (if $check_parsers { "0" } else { "1" }) } {
    ^nvim --headless -c $"luafile ($runner)"
    if $env.LAST_EXIT_CODE != 0 {
      error make { msg: $"Neovim exited with status ($env.LAST_EXIT_CODE)" }
    }
  }
}

let startup_error = try {
  with-env {
    NRM_EXPECTED_APP: "nvim",
    NRM_EXPECTED_CONFIG: "native",
    NRM_EXPECTED_CONFIG_SOURCE: ($root | path join ".config" "nvim" "init.lua"),
    XDG_DATA_HOME: ($sandbox | path join "data"),
    XDG_STATE_HOME: ($sandbox | path join "state"),
    XDG_CACHE_HOME: ($sandbox | path join "cache"),
  } {
    run-startup false
    run-startup true
  }
  null
} catch { |error| $error }

let lock_after = try {
  open --raw $lockfile | hash sha256
} catch {
  null
}
rm --recursive --force $sandbox

if $startup_error != null {
  error make { msg: $"Native Neovim bootstrap failed: ($startup_error.msg)" }
}

if $lock_after == null {
  error make { msg: "Plugin restoration removed or corrupted nvim-pack-lock.json" }
}

if $lock_before != $lock_after {
  error make { msg: "Plugin restoration changed nvim-pack-lock.json" }
}

print "PASS nvim clean and warm bootstrap"
