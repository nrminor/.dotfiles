#!/usr/bin/env nu
#MISE description="Run the bounded Neovim migration contracts"

let root = $env.MISE_PROJECT_ROOT
let startup_runner = $root | path join "scripts" "test-nvim-startup.lua"
let editing_runner = $root | path join "scripts" "test-nvim-structured-editing.lua"
let interface_runner = $root | path join "scripts" "test-nvim-interface-navigation.lua"
let typescript_runner = $root | path join "scripts" "test-nvim-typescript.lua"
let repository_navigation_runner = $root | path join "scripts" "test-nvim-repository-navigation.lua"

def require-success [label: string] {
  if $env.LAST_EXIT_CODE != 0 {
    error make { msg: $"($label) exited with status ($env.LAST_EXIT_CODE)" }
  }
}

def check-startup [] {
  with-env {
    NRM_EXPECTED_APP: "nvim",
    NRM_EXPECTED_CONFIG: "native",
    NRM_EXPECTED_CONFIG_SOURCE: ($root | path join ".config" "nvim" "init.lua"),
  } {
    ^nvim --headless -c $"luafile ($startup_runner)"
    require-success "native Neovim startup contract"
  }
}

def check-structured-editing [] {
  ^nvim --headless -c $"luafile ($editing_runner)"
  require-success "native Neovim structured-editing contract"
}

def check-typescript [] {
  with-env {
    NRM_EXPECTED_APP: "nvim",
    NRM_REPO_ROOT: $root,
  } {
    ^nvim --headless -c $"luafile ($typescript_runner)"
    require-success "native Neovim TypeScript contract"
  }
}

def check-interface [] {
  with-env { NRM_EXPECTED_CONFIG: "native" } {
    ^nvim --headless -c $"luafile ($interface_runner)"
    require-success "native Neovim interface/navigation contract"
  }
}

# Contract scenario 6: public repository navigation behavior in a disposable colocated JJ/Git fixture.
def check-repository-navigation [] {
  ^nvim --headless -c $"luafile ($repository_navigation_runner)"
  require-success "native Neovim repository-navigation contract"
}

check-startup
check-structured-editing
check-typescript
check-interface
check-repository-navigation
