#!/usr/bin/env nu
#MISE description="Run the bounded Neovim migration contracts"

let root = $env.MISE_PROJECT_ROOT
let startup_runner = $root | path join "scripts" "test-nvim-startup.lua"
let editing_runner = $root | path join "scripts" "test-nvim-structured-editing.lua"

def require-success [label: string] {
  if $env.LAST_EXIT_CODE != 0 {
    error make { msg: $"($label) exited with status ($env.LAST_EXIT_CODE)" }
  }
}

def check-nixvim [] {
  let executable = $"/etc/profiles/per-user/($env.USER)/bin/nvim"
  with-env {
    NVIM_APPNAME: "nvim",
    NRM_EXPECTED_APP: "nvim",
    NRM_EXPECTED_CONFIG: "nixvim",
  } {
    ^$executable --headless -c $"luafile ($startup_runner)"
    require-success "nixvim startup contract"
  }
}

def check-native [] {
  with-env {
    NRM_EXPECTED_APP: "nvim-next",
    NRM_EXPECTED_CONFIG: "native",
    NRM_EXPECTED_CONFIG_SOURCE: ($root | path join ".config" "nvim" "init.lua"),
    NRM_EXPECTED_PACK_COUNT: "42",
  } {
    ^mise run nvim:next -- --headless -c $"luafile ($startup_runner)"
    require-success "native Neovim startup contract"
  }
}

def check-nixvim-editing [] {
  let executable = $"/etc/profiles/per-user/($env.USER)/bin/nvim"
  with-env { NVIM_APPNAME: "nvim" } {
    ^$executable --headless -c $"luafile ($editing_runner)"
    require-success "nixvim structured-editing contract"
  }
}

def check-native-editing [] {
  ^mise run nvim:next -- --headless -c $"luafile ($editing_runner)"
  require-success "native Neovim structured-editing contract"
}

check-nixvim
check-native
check-nixvim-editing
check-native-editing
