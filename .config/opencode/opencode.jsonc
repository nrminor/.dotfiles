{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "careful",
  "agents": {
    "general": {
      "model": "openai/gpt-6.1-terra",
    },
  },
  "experimental": {
    "background_compaction": true
  },
  "providers": {
    "openai": {
      "models": {
        "gpt-6.1-sol": {
          "variants": [
            { "id": "high", "settings": { "reasoningEffort": "high" } },
          ],
        },
        "gpt-6-astra": {
          "variants": [
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } },
          ],
        },
        "gpt-6-luna": {
          "variants": [
            { "id": "low", "settings": { "reasoningEffort": "low" } },
          ],
        },
      },
    },
  },
  "mcp": {
    "servers": {
      "browse": {
        "type": "local",
        "command": ["mise", "exec", "--", "browse", "mcp"],
        "environment": {
          "OPENCODE_BROWSER_AUTO_UPDATE": "off",
        },
      },
      "bear": {
        "type": "local",
        "command": [
          "/Applications/Bear.app/Contents/MacOS/bearcli",
          "mcp-server",
        ],
        "disabled": false,
      },
    },
  },
}
