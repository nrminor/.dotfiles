{
  "name": "pi-mpl-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check": "nub run typecheck && nub run test",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "allowScripts": {
    "mpl@https://github.com/dmmulroy/mpl.git#54651f9df561a420ae63f3cfb7631d72d297510d": true
  },
  "dependencies": {
    "mpl": "git+https://github.com/dmmulroy/mpl.git#54651f9df561a420ae63f3cfb7631d72d297510d",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@types/node": "^24.5.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
