giti# Ignore everything by default
*

# ============================================================================
# Project Files (Development Tooling)
# ============================================================================

!.gitignore
!.pre-commit-config.yaml
!mise.toml
!mise.lock
!pnpm-lock.yaml
!package.json
!README.md
!LICENSE
!docs
!docs/*.md

# ============================================================================
# Project Directories
# ============================================================================

# Mise project tasks
!/.mise
!/.mise/tasks
!/.mise/tasks/**

# Validation scripts
!/scripts
!/scripts/*.js
!/scripts/*.ts
!/scripts/*.sh
!/scripts/*.nu
!/scripts/*.lua

# ============================================================================
# Managed dotfile sources
# ============================================================================

# Allow .config directory structure
!/.config

# Atuin
!/.config/atuin
!/.config/atuin/config.toml
!/.config/atuin/init.nu

# btop
!/.config/btop
!/.config/btop/btop.conf
!/.config/btop/themes
!/.config/btop/themes/*.theme

# Fastfetch
!/.config/fastfetch
!/.config/fastfetch/config.jsonc

# Ghostty
!/.config/ghostty
!/.config/ghostty/config

# Rex server configuration and Mac preference inputs
!/.config/rex
!/.config/rex/init.lua
!/.config/rex/preferences.json
!/.config/rex/sdk-source.json
!/.config/rex/Catppuccin Macchiato

# Git
!/.config/git
!/.config/git/.gitconfig

# Helix
!/.config/helix
!/.config/helix/config.toml
!/.config/helix/languages.toml
!/.config/helix/runtime
!/.config/helix/runtime/themes
!/.config/helix/runtime/themes/*.toml

# Jujutsu
!/.config/jj
!/.config/jj/config.toml

# Oyui
!/.config/oyui
!/.config/oyui/config.rn

# Zoxide
!/.config/zoxide
!/.config/zoxide/.zoxide.nu

# Mise
!/.config/miserc.toml
!/.config/mise
!/.config/mise/config.toml
!/.config/mise/config.linux.toml
!/.config/mise/config.macos.toml

# mbx policy; generated shims and cache stay outside the repository.
!/.config/mbx
!/.config/mbx/config.toml

# Nextflow
!/.config/nextflow
!/.config/nextflow/bin
!/.config/nextflow/bin/nextflow-language-server

# Nix (modular cross-platform config)
!/.config/nix
!/.config/nix/flake.nix
!/.config/nix/flake.lock
!/.config/nix/modules
!/.config/nix/modules/common
!/.config/nix/modules/common/*.nix
!/.config/nix/modules/darwin
!/.config/nix/modules/darwin/*.nix
!/.config/nix/modules/home
!/.config/nix/modules/home/*.nix
!/.config/nix/modules/home/*.patch
# Native Neovim
!/.config/nvim
!/.config/nvim/init.lua
!/.config/nvim/nvim-pack-lock.json
!/.config/nvim/colors
!/.config/nvim/colors/*.lua
!/.config/nvim/lua
!/.config/nvim/lua/**
!/.config/nvim/snippets
!/.config/nvim/snippets/**
!/.config/nvim/after
!/.config/nvim/after/**

# Direnv
!/.config/direnv
!/.config/direnv/direnv.toml

# Shell
!/.config/shell
!/.config/shell/.direnvrc
!/.config/shell/.hushlogin
!/.config/shell/.zprofile
!/.config/shell/.zshenv
!/.config/shell/.zshrc

# Nushell
!/.config/nushell
!/.config/nushell/*.nu

# Yazi
!/.config/yazi
!/.config/yazi/yazi.toml
!/.config/yazi/theme.toml
!/.config/yazi/keymap.toml
!/.config/yazi/init.lua
!/.config/yazi/package.toml

# Zed
!/.config/zed
!/.config/zed/keymap.json
!/.config/zed/settings.json

# herdr
!/.config/herdr
!/.config/herdr/config.toml

# Herdr Desktop inputs; session state and shipped layouts stay local.
!/.config/herdr-core
!/.config/herdr-core/config.toml
!/.config/herdr-app
!/.config/herdr-app/settings.json
!/.config/herdr-app/keys.json
!/.config/herdr-app/themes
!/.config/herdr-app/themes/*.json

# tuicr
!/.config/tuicr
!/.config/tuicr/config.toml

# bat config
!/.config/bat
!/.config/bat/config

# lazygit
!/.config/lazygit
!/.config/lazygit/config.yml

# starship config
!/.config/starship.toml

# tldr config
!/.config/tlrc
!/.config/tlrc/config.toml

# OpenCode config. Skills and commands are installed by the global mise
# bootstrap, not vendored here.
!/.config/opencode
!/.config/opencode/opencode.json
!/.config/opencode/opencode.jsonc
!/.config/opencode/cli.json
!/.config/opencode/agents
!/.config/opencode/agents/*.md
!/.config/opencode/plugins
!/.config/opencode/plugins/*.ts
!/.config/opencode/plugins/*.js
!/.config/opencode/plugins/rex
!/.config/opencode/plugins/rex/package.json
!/.config/opencode/plugins/rex/pnpm-lock.yaml
!/.config/opencode/plugins/rex/*.ts
!/.config/opencode/plugins/rex/tsconfig.json
!/.config/opencode/plugins/rex/vendor
!/.config/opencode/plugins/rex/vendor/*.ts
!/.config/opencode/plugins/rex/vendor/LICENSE
!/.config/opencode/plugins/rex/tests
!/.config/opencode/plugins/rex/tests/*.ts

# Pi configuration and curated extensions; credentials and sessions stay outside the repo.
!/.config/pi
!/.config/pi/AGENTS.md
!/.config/pi/settings.json
!/.config/pi/extensions
!/.config/pi/extensions/mpl
!/.config/pi/extensions/rex
!/.config/pi/extensions/rex/package.json
!/.config/pi/extensions/rex/pnpm-lock.yaml
!/.config/pi/extensions/rex/*.ts
!/.config/pi/extensions/rex/tsconfig.json
!/.config/pi/extensions/rex/vendor
!/.config/pi/extensions/rex/vendor/*.ts
!/.config/pi/extensions/rex/vendor/LICENSE
!/.config/pi/extensions/rex/test
!/.config/pi/extensions/rex/test/*.ts
!/.config/pi/extensions/mpl/*.ts
!/.config/pi/extensions/mpl/package.json
!/.config/pi/extensions/mpl/nub.lock
!/.config/pi/extensions/mpl/tsconfig.json
!/.config/pi/extensions/mpl/ATTRIBUTION
!/.config/pi/extensions/mpl/LICENSE-mpl
!/.config/pi/extensions/mpl/THIRD_PARTY_NOTICES-mpl.md
!/.config/pi/extensions/mpl/styles
!/.config/pi/extensions/mpl/styles/*.mplstyle
!/.config/pi/extensions/mpl/test
!/.config/pi/extensions/mpl/test/*.ts

# prettier
!/.config/.prettierrc

# oxc (oxfmt, oxlint, etc.)
!/.config/.oxfmtrc.json
!/.config/.oxfmtrc.jsonc

# Ignore common unwanted files
/.config/**/.DS_Store

# Ignore build artifacts within .config
/.config/.direnv/
