giti# Ignore everything by default
*

# ============================================================================
# Project Files (Development Tooling)
# ============================================================================

!.gitignore
!.pre-commit-config.yaml
!mise.toml
!mise.lock
!pnpm-lock.yaml
!package.json
!Cargo.toml
!README.md
!LICENSE
!docs
!docs/*.md

# ============================================================================
# Project Directories
# ============================================================================

# Mise project tasks
!/.mise
!/.mise/tasks
!/.mise/tasks/**

# Dotter configuration
!/.dotter
!/.dotter/global.toml
!/.dotter/macos.toml
!/.dotter/local.toml

# Validation scripts
!/scripts
!/scripts/*.js
!/scripts/*.ts
!/scripts/*.sh
!/scripts/*.nu
!/scripts/*.rs
!/scripts/*.lua

# ============================================================================
# Dotfiles to be Deployed (Managed by Dotter)
# ============================================================================

# Allow .config directory structure
!/.config

# Atuin
!/.config/atuin
!/.config/atuin/config.toml
!/.config/atuin/init.nu

# btop
!/.config/btop
!/.config/btop/btop.conf
!/.config/btop/themes
!/.config/btop/themes/*.theme

# Fastfetch
!/.config/fastfetch
!/.config/fastfetch/config.jsonc

# Ghostty
!/.config/ghostty
!/.config/ghostty/config

# Git
!/.config/git
!/.config/git/.gitconfig

# Helix
!/.config/helix
!/.config/helix/config.toml
!/.config/helix/languages.toml
!/.config/helix/runtime
!/.config/helix/runtime/themes
!/.config/helix/runtime/themes/*.toml

# Jujutsu
!/.config/jj
!/.config/jj/config.toml

# Oyui
!/.config/oyui
!/.config/oyui/config.rn

# Zoxide
!/.config/zoxide
!/.config/zoxide/.zoxide.nu

# Marimo
!/.config/marimo
!/.config/marimo/config.toml

# Mise
!/.config/mise
!/.config/mise/config.toml
!/.config/mise/tasks
!/.config/mise/tasks/**

# Nix (modular cross-platform config)
!/.config/nix
!/.config/nix/flake.nix
!/.config/nix/flake.lock
!/.config/nix/modules
!/.config/nix/modules/common
!/.config/nix/modules/common/*.nix
!/.config/nix/modules/darwin
!/.config/nix/modules/darwin/*.nix
!/.config/nix/modules/home
!/.config/nix/modules/home/*.nix
!/.config/nix/modules/home/*.patch
# Neovim (nixvim config)
!/.config/nixvim
!/.config/nixvim/*.nix
!/.config/nixvim/colors
!/.config/nixvim/colors/*.lua
!/.config/nixvim/plugins
!/.config/nixvim/plugins/*.nix
!/.config/nixvim/plugins/*.lua
!/.config/nixvim/plugins/languages
!/.config/nixvim/plugins/languages/queries
!/.config/nixvim/plugins/languages/*.nix
!/.config/nixvim/plugins/languages/*.lua
!/.config/nixvim/plugins/languages/queries/markdown
!/.config/nixvim/plugins/languages/queries/markdown/*.scm
!/.config/nixvim/plugins/snacks
!/.config/nixvim/plugins/snacks/*.nix
!/.config/nixvim/plugins/snippets
!/.config/nixvim/plugins/snippets/typescript
!/.config/nixvim/plugins/snippets/typescript/*.lua

# Native Neovim
!/.config/nvim
!/.config/nvim/init.lua
!/.config/nvim/nvim-pack-lock.json
!/.config/nvim/lua
!/.config/nvim/lua/**
!/.config/nvim/after
!/.config/nvim/after/**

# Direnv
!/.config/direnv
!/.config/direnv/direnv.toml

# Nix Direnv
!/.config/nix-direnv
!/.config/nix-direnv/config.toml

# Shell
!/.config/shell
!/.config/shell/.direnvrc
!/.config/shell/.hushlogin
!/.config/shell/.zprofile
!/.config/shell/.zshenv
!/.config/shell/.zshrc

# Nushell
!/.config/nushell
!/.config/nushell/*.nu

# Yazi
!/.config/yazi
!/.config/yazi/yazi.toml
!/.config/yazi/theme.toml
!/.config/yazi/keymap.toml
!/.config/yazi/init.lua
!/.config/yazi/flavors
!/.config/yazi/flavors/catppuccin-frappe.yazi
!/.config/yazi/flavors/catppuccin-frappe.yazi/*.toml
!/.config/yazi/flavors/catppuccin-frappe.yazi/*.xml
!/.config/yazi/flavors/catppuccin-frappe.yazi/*.png
!/.config/yazi/flavors/catppuccin-frappe.yazi/LICENSE*
!/.config/yazi/flavors/catppuccin-frappe.yazi/README.md
!/.config/yazi/flavors/catppuccin-latte.yazi
!/.config/yazi/flavors/catppuccin-latte.yazi/*.toml
!/.config/yazi/flavors/catppuccin-latte.yazi/*.xml
!/.config/yazi/flavors/catppuccin-latte.yazi/*.png
!/.config/yazi/flavors/catppuccin-latte.yazi/LICENSE*
!/.config/yazi/flavors/catppuccin-latte.yazi/README.md
!/.config/yazi/flavors/catppuccin-macchiato.yazi
!/.config/yazi/flavors/catppuccin-macchiato.yazi/*.toml
!/.config/yazi/flavors/catppuccin-macchiato.yazi/*.xml
!/.config/yazi/flavors/catppuccin-macchiato.yazi/*.png
!/.config/yazi/flavors/catppuccin-macchiato.yazi/LICENSE*
!/.config/yazi/flavors/catppuccin-macchiato.yazi/README.md
!/.config/yazi/flavors/catppuccin-mocha.yazi
!/.config/yazi/flavors/catppuccin-mocha.yazi/*.toml
!/.config/yazi/flavors/catppuccin-mocha.yazi/*.xml
!/.config/yazi/flavors/catppuccin-mocha.yazi/*.png
!/.config/yazi/flavors/catppuccin-mocha.yazi/LICENSE*
!/.config/yazi/flavors/catppuccin-mocha.yazi/README.md
!/.config/yazi/flavors/dracula.yazi
!/.config/yazi/flavors/dracula.yazi/*.toml
!/.config/yazi/flavors/dracula.yazi/*.xml
!/.config/yazi/flavors/dracula.yazi/*.png
!/.config/yazi/flavors/dracula.yazi/LICENSE*
!/.config/yazi/flavors/dracula.yazi/README.md

# Zed
!/.config/zed
!/.config/zed/keymap.json
!/.config/zed/settings.json

# herdr
!/.config/herdr
!/.config/herdr/config.toml

# Zellij
!/.config/zellij
!/.config/zellij/config.kdl

# bat config
!/.config/bat
!/.config/bat/config

# lazygit
!/.config/lazygit
!/.config/lazygit/config.yml

# gitui
!/.config/gitui
!/.config/gitui/key_bindings.ron
!/.config/gitui/theme.ron

# starship config
!/.config/starship.toml

# tldr config
!/.config/tlrc
!/.config/tlrc/config.toml

# OpenCode config. Skills and commands are installed by the global mise
# bootstrap, not vendored here.
!/.config/opencode
!/.config/opencode/opencode.json
!/.config/opencode/opencode.jsonc
!/.config/opencode/tui.json
!/.config/opencode/agent
!/.config/opencode/agent/*.md
!/.config/opencode/plugin
!/.config/opencode/plugin/*.ts
!/.config/opencode/plugin/*.js

# harlequin
!/.config/.harlequin.toml

# rumdl
!/.config/rumdl
!/.config/rumdl/.rumdl.toml

# prettier
!/.config/.prettierrc

# oxc (oxfmt, oxlint, etc.)
!/.config/.oxfmtrc.json
!/.config/.oxfmtrc.jsonc

# Ignore common unwanted files
/.config/**/.DS_Store

# Ignore build artifacts within .config
/.config/.direnv/
